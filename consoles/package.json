{
  "name": "saas-forge-consoles",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "validate:i18n": "node scripts/validate-i18n-resources.mjs",
    "generate:api": "node scripts/check-api-client.mjs --generate",
    "dev:platform": "pnpm --filter @saas-forge/platform-console run dev",
    "dev:tenant": "pnpm --filter @saas-forge/tenant-console-shell run dev",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test:boundaries": "pnpm run build:static-remote && node --test test/*.test.mjs",
    "build:static-remote": "node scripts/build-static-remote-acceptance.mjs",
    "verify:local:static-remote": "node scripts/verify-local-static-remote-browser.mjs",
    "verify:local:session-security": "node --test integration-test/browser-session-security.test.mjs",
    "test:visual": "bash ../scripts/verify-console-visual.sh",
    "test:browser:consumers": "vitest run --config vitest.consumers.browser.config.ts",
    "test:browser:sessions": "node --test integration-test/session-tabs.test.mjs integration-test/console-default-realm.test.mjs integration-test/brand-remote-acceptance.test.mjs",
    "test:browser:current": "pnpm --filter @saas-forge/admin run test:browser && pnpm run test:browser:consumers && pnpm run test:browser:sessions && node --test integration-test/console-vue-products.test.mjs",
    "test:browser:compatibility": "pnpm run test:browser:chrome",
    "test:browser:chromium": "SF_BROWSER=chromium pnpm run test:browser:current",
    "test:browser:chrome": "SF_BROWSER=chromium SF_BROWSER_CHANNEL=chrome SF_VISUAL_SNAPSHOTS=false pnpm run test:browser:current",
    "test": "pnpm run test:boundaries && pnpm --recursive --if-present run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build:workspace": "pnpm run validate:i18n && pnpm run build:static-remote && pnpm --recursive --if-present run build && node scripts/verify-admin-artifacts.mjs",
    "build": "pnpm run generate:api && pnpm run build:workspace",
    "verify:workspace": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run test:browser:chromium && pnpm run build:workspace",
    "verify": "pnpm run generate:api && pnpm run verify:workspace"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitejs/plugin-vue": "6.0.5",
    "@unocss/vite": "66.6.7",
    "@unocss/preset-wind3": "66.6.7",
    "vue": "3.5.31",
    "vue-router": "5.0.4",
    "element-plus": "2.13.6",
    "eslint-plugin-vue": "10.6.2",
    "vue-eslint-parser": "10.4.0",
    "axe-core": "catalog:"
  }
}
