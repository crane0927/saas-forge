{
  "name": "saas-forge-consoles",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "generate:api": "../mvnw -f ../pom.xml --batch-mode --no-transfer-progress -pl contracts/openapi -am generate-sources",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "pnpm run generate:api && pnpm run typecheck && pnpm run lint && pnpm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
