{
  "name": "saas-forge-consoles",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "generate:api": "../mvnw -f ../pom.xml --batch-mode --no-transfer-progress -pl contracts/openapi -am generate-sources",
    "dev:platform": "pnpm run generate:api && pnpm --filter @saas-forge/platform-console run dev",
    "dev:tenant": "pnpm run generate:api && pnpm --filter @saas-forge/tenant-console-shell run dev",
    "prototype:design-system": "pnpm --filter @saas-forge/design-system-foundation-prototype run dev",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build:workspace": "pnpm --recursive --if-present run build",
    "build": "pnpm run generate:api && pnpm run build:workspace",
    "verify:workspace": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build:workspace",
    "verify": "pnpm run generate:api && pnpm run verify:workspace"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
