    "element-plus": "2.13.6",
    "intl-messageformat": "catalog:",
    "pinia": "3.0.4",
    "vue": "3.5.31",
    "vue-i18n": "11.3.0",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@unocss/preset-wind3": "66.6.7",
    "@unocss/vite": "66.6.7",
    "@vitejs/plugin-vue": "6.0.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "3.2.6"
  }
