{
  "name": "@saas-forge/platform-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/check-api-client.mjs && vite",
    "typecheck": "vue-tsc --noEmit",
