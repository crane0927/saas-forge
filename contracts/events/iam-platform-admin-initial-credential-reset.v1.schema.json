{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasforge.io/contracts/events/iam-platform-admin-initial-credential-reset.v1.schema.json",
  "title": "IAM Platform Admin Initial Credential Reset v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "required": ["traceId"],
      "properties": {
        "type": { "const": "com.saasforge.iam.platform-admin-initial-credential-reset.v1" },
        "source": { "const": "urn:saasforge:iam-service" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identityId",
            "resetRequestId",
            "credentialId",
            "initialCredentialExpiresAt",
            "result",
            "actor",
            "occurredAt"
          ],
          "properties": {
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "resetRequestId": { "$ref": "#/$defs/uuidV7" },
            "credentialId": { "$ref": "#/$defs/uuidV7" },
            "initialCredentialExpiresAt": { "type": "string", "format": "date-time" },
            "result": { "const": "PLATFORM_ADMIN_INITIAL_CREDENTIAL_RESET" },
            "actor": { "const": "SECURITY_OPERATIONS" },
            "occurredAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
