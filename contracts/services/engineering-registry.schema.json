{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasforge.io/contracts/services/engineering-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "entries"],
  "properties": {
    "registryVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceId", "owner", "modulePath", "artifactId", "nacosServiceName", "deployable", "gatewayRouteTargetAllowed"],
      "properties": {
        "serviceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "modulePath": { "type": "string", "pattern": "^(gateway|services/[a-z][a-z0-9-]*)$" },
        "artifactId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "nacosServiceName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "deployable": { "type": "boolean" },
        "gatewayRouteTargetAllowed": { "type": "boolean" }
      }
    }
  }
}
