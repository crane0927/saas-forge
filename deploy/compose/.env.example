# 复制为 .env 后，为每个变量设置仅用于本地开发的值。
# Postgres
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
IAM_MIGRATOR_PASSWORD=
IAM_APP_PASSWORD=
IAM_PLATFORM_ADMIN_EMAIL_FILE=.secrets/platform-admin-email
IAM_PLATFORM_ADMIN_PASSWORD_FILE=.secrets/platform-admin-password
IAM_PLATFORM_ADMIN_RESET_REQUEST_ID_FILE=.secrets/platform-admin-reset-request-id
IAM_PLATFORM_ADMIN_RESET_PASSWORD_FILE=.secrets/platform-admin-reset-password
IAM_SERVICE_CLIENT_ID_FILE=.secrets/iam-client-id
IAM_SERVICE_CLIENT_SECRET_FILE=.secrets/iam-client-secret
IAM_RESERVED_CLIENT_REPLACEMENT_REQUEST_ID=
IAM_RESERVED_CLIENT_REPLACEMENT_SERVICE_KEY=
IAM_RESERVED_CLIENT_REPLACEMENT_OLD_CLIENT_ID=
IAM_RESERVED_CLIENT_REPLACEMENT_NEW_CLIENT_ID=
IAM_RESERVED_CLIENT_REPLACEMENT_SECRET_FILE=.secrets/replacement-client-secret
TENANT_ACCESS_SERVICE_CLIENT_ID_FILE=.secrets/tenant-access-client-id
TENANT_ACCESS_SERVICE_CLIENT_SECRET_FILE=.secrets/tenant-access-client-secret
ENTITLEMENT_SERVICE_CLIENT_ID_FILE=.secrets/entitlement-client-id
ENTITLEMENT_SERVICE_CLIENT_SECRET_FILE=.secrets/entitlement-client-secret
# IAM JWT（私钥文件已被 Git 忽略，仅用于本地开发）
IAM_JWT_ISSUER=https://api.saasforge.test
IAM_JWT_PEM_KEY_VERSION_REF=local/pem/1
IAM_JWT_PEM_PRIVATE_KEY_FILE=.secrets/iam-jwt-private-key.pem
TENANT_ACCESS_MIGRATOR_PASSWORD=
TENANT_ACCESS_APP_PASSWORD=
ENTITLEMENT_MIGRATOR_PASSWORD=
ENTITLEMENT_APP_PASSWORD=
AUDIT_MIGRATOR_PASSWORD=
AUDIT_APP_PASSWORD=
# Redis
REDIS_PASSWORD=
# Nacos
NACOS_BOOTSTRAP_PASSWORD=
NACOS_PUBLISH_USERNAME=
NACOS_PUBLISH_PASSWORD=
NACOS_IAM_USERNAME=
NACOS_IAM_PASSWORD=
NACOS_TENANT_ACCESS_USERNAME=
NACOS_TENANT_ACCESS_PASSWORD=
NACOS_ENTITLEMENT_USERNAME=
NACOS_ENTITLEMENT_PASSWORD=
NACOS_AUDIT_USERNAME=
NACOS_AUDIT_PASSWORD=
NACOS_GATEWAY_USERNAME=
NACOS_GATEWAY_PASSWORD=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_AUTH_TOKEN=
