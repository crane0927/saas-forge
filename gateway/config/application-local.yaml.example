# 复制为同目录 application-local.yaml，IDE 工作目录选 gateway，激活 local。
# 密码通过 IDE 环境变量或外部 configtree 注入；此文件不保存敏感材料。
server:
  address: ${GATEWAY_BIND_ADDRESS:127.0.0.1}
  port: ${GATEWAY_HTTP_PORT:8080}

spring:
  cloud:
    nacos:
      config:
        enabled: false
        import-check:
          enabled: false
      discovery:
        enabled: true
        server-addr: ${NACOS_SERVER_ADDR:127.0.0.1:8848}
        namespace: ${NACOS_NAMESPACE:dev}
        ip: ${GATEWAY_REGISTER_IP:127.0.0.1}
        port: ${GATEWAY_HTTP_PORT:8080}
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD}

saasforge:
  environment: dev
  gateway:
    configuration-revision: local
  local-replacement:
    enabled: false

security:
  jwt:
    issuer: ${IAM_JWT_ISSUER}

management:
  endpoint:
    health:
      probes:
        enabled: true
      group:
        liveness:
          include: livenessState
        readiness:
          include: readinessState,nacosRegistrationReadiness
