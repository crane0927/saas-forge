{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logical Cache Invalidated Event v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saasforge.cache.invalidated.v1" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/membershipScope" },
            { "$ref": "#/$defs/tenantScope" },
            { "$ref": "#/$defs/globalScope" }
          ]
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "membershipScope": {
      "type": "object",
      "required": ["cacheDomain", "scope", "tenantId", "membershipId"],
      "properties": {
        "cacheDomain": { "enum": ["authorization", "entitlement"] },
        "scope": { "const": "MEMBERSHIP" },
        "tenantId": { "$ref": "#/$defs/uuidV7" },
        "membershipId": { "$ref": "#/$defs/uuidV7" }
      },
      "additionalProperties": false
    },
    "tenantScope": {
      "type": "object",
      "required": ["cacheDomain", "scope", "tenantId"],
      "properties": {
        "cacheDomain": { "enum": ["authorization", "entitlement"] },
        "scope": { "const": "TENANT" },
        "tenantId": { "$ref": "#/$defs/uuidV7" }
      },
      "additionalProperties": false
    },
    "globalScope": {
      "type": "object",
      "required": ["cacheDomain", "scope"],
      "properties": {
        "cacheDomain": { "enum": ["authorization", "entitlement"] },
        "scope": { "const": "GLOBAL" }
      },
      "additionalProperties": false
    }
  }
}
