{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasforge.io/contracts/events/iam-password-changed.v1.schema.json",
  "title": "IAM Password Changed v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saasforge.iam.password.changed.v1" },
        "source": { "const": "urn:saasforge:iam-service" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityId", "familyId", "credentialId", "purpose", "result", "occurredAt"],
          "properties": {
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "familyId": { "$ref": "#/$defs/uuidV7" },
            "credentialId": { "$ref": "#/$defs/uuidV7" },
            "purpose": { "const": "INITIAL_PASSWORD_CHANGE" },
            "result": { "const": "PASSWORD_CHANGED" },
            "occurredAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
