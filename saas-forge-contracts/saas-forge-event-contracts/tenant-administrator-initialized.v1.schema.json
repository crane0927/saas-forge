{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas.forge.io/contracts/events/tenant-administrator-initialized.v1.schema.json",
  "title": "Tenant Administrator Initialized v1",
  "allOf": [
    { "$ref": "cloudevents-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "com.saas.forge.tenant.administrator-initialized.v1" },
        "source": { "const": "urn:saas.forge:tenant-access-service" },
        "subject": { "$ref": "#/$defs/uuidV7" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "membershipId", "identityId", "roleId", "status", "actorIdentityId"],
          "properties": {
            "tenantId": { "$ref": "#/$defs/uuidV7" },
            "membershipId": { "$ref": "#/$defs/uuidV7" },
            "identityId": { "$ref": "#/$defs/uuidV7" },
            "roleId": { "$ref": "#/$defs/uuidV7" },
            "status": { "const": "ACTIVE" },
            "actorIdentityId": { "$ref": "#/$defs/uuidV7" }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
