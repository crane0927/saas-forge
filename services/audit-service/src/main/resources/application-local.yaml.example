# 复制为同目录 application-local.yaml，IDE 激活 local；凭据仅通过环境变量或受限文件注入。
# 非敏感策略来自 deploy/nacos/dev/audit-service.yaml；迁移和 Kafka topic/ACL 独立准备。
saasforge:
  audit:
    configuration-revision: local
    consumer:
      max-attempts: 10
      initial-backoff: PT1S
      max-backoff: PT1M
    isolation:
      publish-delay: PT1S
      lease-duration: PT30S

management:
  endpoint:
    health:
      probes:
        enabled: true
      group:
        liveness:
          include: livenessState
        readiness:
          include: readinessState,nacosRegistrationReadiness,auditRuntimeReadiness

spring:
  cloud:
    nacos:
      config:
        enabled: false
        import-check:
          enabled: false
      discovery:
        enabled: true
        server-addr: ${NACOS_SERVER_ADDR:127.0.0.1:8848}
        namespace: ${NACOS_NAMESPACE:dev}
        ip: ${AUDIT_REGISTER_IP:127.0.0.1}
        port: ${AUDIT_HTTP_PORT:8084}
    discovery:
      client:
        health-indicator:
          use-services-query: false
  datasource:
    url: ${AUDIT_DATABASE_URL:jdbc:postgresql://127.0.0.1:5432/audit_db}
    username: ${AUDIT_DATABASE_USERNAME:audit_app}
    password: ${AUDIT_DATABASE_PASSWORD}
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:127.0.0.1:29092}

server:
  address: ${AUDIT_BIND_ADDRESS:127.0.0.1}
  port: ${AUDIT_HTTP_PORT:8084}
