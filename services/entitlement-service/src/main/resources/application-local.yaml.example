# 复制为同目录 application-local.yaml，IDE 激活 local；凭据仅通过环境变量或受限文件注入。
# 非敏感策略来自 deploy/nacos/dev/entitlement-service.yaml；初始化迁移独立执行。
saasforge:
  entitlement:
    configuration-revision: local

security:
  jwt:
    issuer: ${IAM_JWT_ISSUER:?IAM_JWT_ISSUER is required}

management:
  endpoint:
    health:
      probes:
        enabled: true
      group:
        liveness:
          include: livenessState
        readiness:
          include: readinessState,nacosRegistrationReadiness

spring:
  cloud:
    nacos:
      config:
        enabled: false
        import-check:
          enabled: false
      discovery:
        enabled: true
        metadata:
          grpc.port: ${spring.grpc.server.port}
        server-addr: ${NACOS_SERVER_ADDR:127.0.0.1:8848}
        namespace: ${NACOS_NAMESPACE:dev}
        ip: ${ENTITLEMENT_REGISTER_IP:127.0.0.1}
        port: ${ENTITLEMENT_HTTP_PORT:8083}
  datasource:
    url: ${ENTITLEMENT_DATASOURCE_URL:jdbc:postgresql://127.0.0.1:5432/entitlement_db}
    username: ${ENTITLEMENT_DATASOURCE_USERNAME:entitlement_app}
    password: ${ENTITLEMENT_APP_PASSWORD}
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD}
  grpc:
    server:
      port: ${ENTITLEMENT_GRPC_PORT:9093}
    client:
      channels:
        iam:
          default-deadline: PT3S
        tenant-access:
          default-deadline: PT3S

server:
  address: ${ENTITLEMENT_BIND_ADDRESS:127.0.0.1}
  port: ${ENTITLEMENT_HTTP_PORT:8083}
