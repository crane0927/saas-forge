<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.saasforge.iam.infrastructure.persistence.mapper.PlatformAdminCredentialResetMapper">
    <resultMap id="resetFactRow"
               type="io.saasforge.iam.infrastructure.persistence.record.PlatformAdminCredentialResetFactRow">
        <id property="resetRequestId" column="reset_request_id"/>
        <result property="identityId" column="identity_id"/>
        <result property="credentialId" column="credential_id"/>
        <result property="eventId" column="event_id"/>
        <result property="resetAt" column="reset_at"/>
    </resultMap>

    <select id="lockReset" resultType="int">
        SELECT 1
        FROM pg_advisory_xact_lock(1935762249, 2)
    </select>

    <select id="findByRequestId" resultMap="resetFactRow">
        SELECT reset_request_id, identity_id, credential_id, event_id, reset_at
        FROM iam_platform_admin_credential_reset_facts
        WHERE reset_request_id = #{resetRequestId}
    </select>

    <insert id="insert">
        INSERT INTO iam_platform_admin_credential_reset_facts
            (reset_request_id, identity_id, credential_id, event_id, reset_at)
        VALUES
            (#{resetRequestId}, #{identityId}, #{credentialId}, #{eventId}, #{resetAt})
    </insert>
</mapper>
